rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper function to check if the authenticated user is an admin.
    // This function reads the user's document from Firestore and checks for the 'admin' role.
    function isAdmin() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      // Check if the 'roles' field exists and if 'admin' is in the roles array.
      return request.auth != null && 'roles' in userDoc.data && 'admin' in userDoc.data.roles;
    }
    
    // Rule for lot images.
    match /lot-images/{imageId} {
      allow read;
      allow write: if request.auth != null
                   && request.resource.contentType.matches('image/.*')
                   && request.resource.size < 5 * 1024 * 1024;
    }

    // Rule for user profile pictures.
    // Users can only write to their own avatar folder.
    match /user-avatars/{userId}/{imageName} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Rule for blog cover images.
    match /blog-covers/{imageId} {
      allow read; // Anyone can read cover images
      
      // --- TEMPORARY DEBUGGING RULE ---
      // Allow write for any authenticated user to test if the get() call is the issue.
      allow write: if request.auth != null
                   && request.resource.contentType.matches('image/.*')
                   && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
