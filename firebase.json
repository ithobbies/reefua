{
  "functions": [
    {
      "source": "functions",
      "runtime": "nodejs18",
      "name": "nextServer"
    }
  ],
  "hosting": {
    "public": ".next",
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "**",
        "function": "nextServer"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199,
      "rules": "storage.rules",
      "cors": "cors.json"
    },
    "ui": {
      "enabled": true
    }
  }
}
